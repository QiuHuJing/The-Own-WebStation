# WebOwn 环境配置（复制为 .env 并修改）
# JWT 密钥：openssl rand -hex 48 生成，务必修改！
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=production
PORT=3000
# 是否部署在 HTTPS 下：1=开启 HSTS 与 upgrade-insecure-requests；免 SSL（纯 http）部署请设为 0 或留空
SSL=1
# 使用反向代理（宝塔 / nginx）时设为 1，便于正确获取真实 IP 与协议（Cookie 的 Secure 会自动跟随真实协议）
TRUST_PROXY=1

# ===== 邮件（注册/找回密码验证码，仅走 Resend HTTPS API）=====
# 推荐方案 Resend（免费 3000 封/月，用自有域名发信，走 443 绕开云服务器 SMTP 端口/IP 黑名单）
#   1) 注册 https://resend.com → API Keys 页面创建，拿到 API Key（形如 re_xxxx）
#   2) Resend 后台「Domains」添加你的域名，按提示加 SPF / DKIM（及 DMARC）DNS 记录并验证
#   3) 把下方 RESEND_API_KEY 填上即可，无需改代码（未验证域名时 Resend 会拒发 422）
RESEND_API_KEY=
RESEND_FROM=noreply@yuezhihai.xyz   # 已在 Resend 验证过的发件地址（须用你自己的域名）
RESEND_FROM_NAME=月之海

# ===== 隐私 / 数据保留（可选，均有默认值）=====
# 浏览记录保留时长（毫秒）：默认 90 天（7776000000）。设为更短可更快清理。
BROWSE_TTL_MS=7776000000
# 浏览记录清理频率（毫秒）：默认 6 小时（21600000）。
BROWSE_CLEAN_INTERVAL_MS=21600000

