JWT_SECRET=c420ba60831b5c2aab4b6d4b8b89c161ff7447f6bb20b052cb1b5782856ad0a8729cf7a488205bffa18e5ae6b253e241
NODE_ENV=production
PORT=3000
# 部署在 Nginx 反代后务必设为 1：才能拿到真实客户端 IP（否则所有限速/登录锁定都共用 127.0.0.1，
# 既会让正常用户被误限，也会让攻击者一次锁定全站），并让 Cookie 的 Secure 跟随真实协议。
TRUST_PROXY=1
# 站点已用 HTTPS（Let's Encrypt/Nginx）：开启 HSTS 强制 HTTPS 并让 Cookie 自动 Secure。
# 若某环境是纯 HTTP 部署，请改回 0，否则 HSTS 会强制跳 HTTPS 导致白屏。
SSL=1
